# =====================================================================
# ShopGenie AI — Backend Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# PostgreSQL (Supabase / Render) connection string.
# Leave empty or commented out to use local SQLite (instance/shop_faq.db)
# DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------
# Security & Auth Secrets
# ---------------------------------------------------------------------
SECRET_KEY=shopgenie-super-secret-key-change-in-production
JWT_SECRET_KEY=shopgenie-jwt-secret-key-change-in-production

# ---------------------------------------------------------------------
# AI Provider (gemini or claude)
# ---------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
ANTHROPIC_API_KEY=your_claude_api_key_if_using_claude

# ---------------------------------------------------------------------
# EMAIL PROVIDER CONFIGURATION (Choose EITHER Resend OR Gmail SMTP)
# ---------------------------------------------------------------------
# Specify active provider: 'resend' or 'smtp'
EMAIL_PROVIDER=resend

# Option A: Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Note: If your custom domain is not yet verified on Resend, you MUST use 'onboarding@resend.dev'
# as the sender. Resend free accounts can only deliver to the account owner's email address.
MAIL_FROM=onboarding@resend.dev

# Option B: Gmail / Standard SMTP Configuration
# If using Gmail:
# 1. Turn on 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 3. Set SMTP_SERVER=smtp.gmail.com, SMTP_PORT=587, and your App Password below
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_USE_TLS=true
# SMTP_TIMEOUT=10

# ---------------------------------------------------------------------
# TWO-WAY EMAIL COMMUNICATION (Incoming replies from customers)
# ---------------------------------------------------------------------
# Option 1: Gmail IMAP Polling / Sync (used with Gmail SMTP)
# Automatically checks for incoming replies to your Gmail inbox.
# Uses the same Gmail App Password credentials by default.
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USERNAME=your-email@gmail.com
# IMAP_PASSWORD=your-16-character-app-password

# Option 2: Resend Inbound Webhook / Custom Inbound Provider
# Receives incoming webhook events at /api/email/inbound
# EMAIL_INBOUND_SECRET=your-inbound-webhook-secret

# ---------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CUSTOMER_SESSION_HOURS=36
